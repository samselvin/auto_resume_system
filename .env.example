# Optional. Used for self-referential links in production.
APP_URL="http://localhost:3000"

# Required for real "Sign in with Google" (replaces the old fake local login).
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create Credentials -> OAuth client ID -> Application type: Web application
# 3. Authorized JavaScript origins: add http://localhost:3000 for dev, plus your
#    deployed site's URL (e.g. https://your-app.example.com) for production.
# 4. No redirect URI or client secret is needed for this flow (Google Identity
#    Services ID-token sign-in) — just the Client ID below.
# 5. Set the SAME value in both variables: GOOGLE_CLIENT_ID is read by the server
#    to verify tokens, VITE_GOOGLE_CLIENT_ID is baked into the client bundle so
#    the Sign in with Google button can initialize.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Required. Signs the app's own session cookie after a user is verified (by Google or
# by email OTP).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# For the "Create Account with email" flow's one-time verification code. Without any of
# this set, the server logs the code to its own console instead of emailing it (fine for
# local testing, not for real students).
#
# RESEND_API_KEY is tried first, and is the one that actually works on hosts like Render:
# many platforms block outbound SMTP ports (25/465/587) entirely to prevent abuse — Resend
# sends over plain HTTPS instead, so it isn't affected. Get a key at https://resend.com
# (free tier, no credit card). Without a verified sending domain, Resend's default
# "onboarding@resend.com" sender can only deliver to the email address that owns the
# Resend account — fine for testing solo, but verify a domain (in the Resend dashboard)
# and set RESEND_FROM to an address on it before real students sign up.
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.com"
RESEND_FROM_NAME="ATS Student Jobs"

# SMTP is the fallback used only when RESEND_API_KEY isn't set — works fine locally, but
# don't rely on it in production if your host blocks outbound SMTP the way Render does.
#  - Gmail: host smtp.gmail.com, port 587, user = your Gmail address, pass = a 16-char
#    "App Password" from https://myaccount.google.com/apppasswords (NOT your normal
#    Gmail password — that won't work and Google will reject plain password SMTP login).
# SMTP_FROM_NAME/RESEND_FROM_NAME only change the display name shown next to the address
# (e.g. "ATS Student Jobs <you@gmail.com>") — with Gmail's own SMTP relay the address
# itself must still be the authenticated account, so a personal Gmail address is NOT fully
# hidden from a recipient who checks "show details." Resend with a verified domain is the
# only option here that keeps a personal inbox out of it entirely.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="ATS Student Jobs"
